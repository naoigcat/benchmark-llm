{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/benchmark/trial.schema.json",
  "title": "LLM benchmark trial",
  "type": "object",
  "required": [
    "run_id",
    "trial_id",
    "host_id",
    "target_fingerprint",
    "target_id",
    "task_id",
    "repeat",
    "adapter",
    "inference_location",
    "model_requested",
    "cache_condition",
    "status",
    "passed"
  ],
  "properties": {
    "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{12}Z-[a-z0-9._-]+$" },
    "trial_id": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "host_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "host_memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "target_id": { "type": "string" },
    "target_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_id": { "type": "string" },
    "task_category": { "type": "string" },
    "repeat": { "type": "integer", "minimum": 1 },
    "generation_seed": { "type": ["integer", "null"], "minimum": 1 },
    "adapter": { "enum": ["ollama", "cli-agent"] },
    "backend": { "type": ["string", "null"] },
    "backend_version": { "type": ["string", "null"] },
    "inference_location": { "enum": ["local", "remote"] },
    "model_requested": { "type": "string" },
    "model_resolved": { "type": ["string", "null"] },
    "model_revision": { "type": ["string", "null"] },
    "quantization": { "type": ["string", "null"] },
    "context_window": { "type": ["integer", "null"], "minimum": 0 },
    "cache_condition": { "enum": ["cold", "warm", "provider-managed"] },
    "status": { "enum": ["completed", "error", "skipped"] },
    "passed": { "type": "boolean" },
    "failure_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "evaluation_failed",
        "output_truncated",
        "preflight_failed",
        "timeout",
        "interrupted",
        "authentication_error",
        "rate_limited",
        "api_error",
        "request_error",
        "runner_error",
        "cleanup_error"
      ]
    },
    "error_message": { "type": ["string", "null"] },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "score_detail": { "type": ["string", "null"] },
    "wall_time_ms": { "type": ["number", "null"], "minimum": 0 },
    "time_to_first_token_ms": { "type": ["number", "null"], "minimum": 0 },
    "prompt_eval_ms": { "type": ["number", "null"], "minimum": 0 },
    "generation_ms": { "type": ["number", "null"], "minimum": 0 },
    "load_ms": { "type": ["number", "null"], "minimum": 0 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens_per_second": { "type": ["number", "null"], "minimum": 0 },
    "finish_reason": { "type": ["string", "null"] },
    "cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "memory_sample_count": { "type": "integer", "minimum": 0 },
    "peak_backend_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "baseline_swap_used_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "peak_swap_used_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "peak_swap_delta_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "model_memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "model_accelerator_memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "loaded_context_window": { "type": ["integer", "null"], "minimum": 0 },
    "runtime_quantization": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
